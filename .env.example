# PayPal sandbox REST app (developer.paypal.com > Apps & Credentials > Sandbox).
# Leave empty to run against the built-in offline PayPal simulator.
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
# Webhook id from the same app, for signature verification of /webhooks/paypal
PAYPAL_WEBHOOK_ID=

# Gemini: mandate compiling, intent checks, plain-language explanations, the live agent.
# Key from https://aistudio.google.com/apikey (GOOGLE_API_KEY also works).
GEMINI_API_KEY=
WARDEN_GEMINI_MODEL=gemini-3.5-flash-lite
# Seconds before the intent check / explanations give up and use Warden's deterministic path.
WARDEN_LLM_TIMEOUT=8
# Site-wide Gemini requests per UTC day (about 70% of the free daily quota). 0 turns the cap off.
WARDEN_LLM_DAILY_CAP=700

# Hosted demo hardening (set on Render): every mandate is capped at $1,500 a week, $500 per payment and the
# default payees plus 2; one budget is shared by every agent id (REST, MCP, demo); Reset demo and 15 idle
# minutes restore the default mandate; approvals record the approver's address.
WARDEN_PUBLIC_DEMO=

# Sandbox ids for hosts without backend/sandbox_seed.json (e.g. Render), merged over the seed file:
# {"invoices": {"INV2-KST7-4Q2M-8ZP3-HC41": "<sandbox invoice id>"}, "disputes": {"PP-D-55210": "<sandbox dispute id>"}}
WARDEN_SANDBOX_SEED=

# Secret used to sign mandates. Change it.
WARDEN_SIGNING_KEY=change-me

# Public URL of this server (used in approval links and the agent's fetches).
WARDEN_PUBLIC_URL=http://localhost:8000

# Push approvals to your phone: install the ntfy app and subscribe to this topic.
WARDEN_NTFY_TOPIC=
# Or POST approvals to a webhook (Zapier, Slack workflow, ...).
WARDEN_APPROVAL_WEBHOOK=

# How long a held MCP call waits for your decision before returning "pending".
WARDEN_APPROVAL_TIMEOUT=45
